# ============================================================
# Ignite Nutrition — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# === Supabase (Required) ===
# Get these from your Supabase project: Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Service role key — KEEP PRIVATE

# === Mercury-2 / Inception Labs AI (Required) ===
# Sign up at https://inceptionlabs.ai to get your API key
INCEPTION_API_KEY=sk-inc-YOUR_INCEPTION_API_KEY
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_MODEL=mercury

# === Gemini Multimodal (Optional — for food image scanning) ===
# Get a free API key from https://aistudio.google.com
EMERGENT_LLM_KEY=AIzaSyYOUR_GEMINI_API_KEY